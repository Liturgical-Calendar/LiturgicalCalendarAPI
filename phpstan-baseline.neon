# This baseline exists solely to work around a PHPStan 2.2.6 regression, not to silence
# real bugs. It was introduced deliberately, not autogenerated as a matter of course — see
# the PR that introduced this file for the full investigation before extending it further.
#
# Root cause: accessing an *optional* property of a `@phpstan-type`/`@param` object-shape
# (e.g. `\stdClass&object{since_year:int,until_year?:int}`) inside an `isset()`/`??`-guarded
# expression used to correctly narrow to the declared property type. As of phpstan/phpstan
# 2.2.6 (up from 2.2.5) this narrowing is lost and the expression is typed as `mixed`, even
# though the guard is present and the runtime value is safe. This was confirmed with a
# minimal reproduction outside of this codebase, bisected between phpstan 2.2.5 (no error)
# and 2.2.6 (error appears), across several equivalent guard styles (`??`, ternary+isset(),
# ternary+property_exists(), and via an intermediate local variable) — none avoid it without
# changing the shape's optionality (which would misrepresent the underlying JSON contract).
# Every entry below is one such case; none of them indicate an actual defect.
parameters:
	ignoreErrors:
		-
			message: '#^Parameter \#1 \$data of static method LiturgicalCalendar\\Api\\Models\\AbstractJsonSrcData\:\:fromObject\(\) expects stdClass, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/Models/Decrees/DecreeItemCreateNewMetadata.php

		-
			message: '#^Parameter \#1 \$data of static method LiturgicalCalendar\\Api\\Models\\AbstractJsonSrcData\:\:fromObject\(\) expects stdClass, mixed given\.$#'
			identifier: argument.type
