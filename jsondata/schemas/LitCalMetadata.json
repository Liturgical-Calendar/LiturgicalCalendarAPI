{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "title": "LitCalMetadata",
    "type": "object",
    "properties": {
        "litcal_metadata": {
            "$ref": "#/definitions/LitCalMetadata"
        }
    },
    "required": [
        "litcal_metadata"
    ],
    "additionalProperties": false,
    "definitions": {
        "LitCalMetadata": {
            "type": "object",
            "properties": {
                "national_calendars": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "calendar_id": {
                                "$ref": "./CommonDef.json#/definitions/Nation"
                            },
                            "locales": {
                                "type": "array",
                                "items": {
                                    "$ref": "./CommonDef.json#/definitions/Locale"
                                }
                            },
                            "missals": {
                                "type": "array",
                                "items": {
                                    "$ref": "./CommonDef.json#/definitions/MissalID"
                                }
                            },
                            "wider_regions": {
                                "type": "array",
                                "uniqueItems": true,
                                "items": {
                                    "$ref": "./CommonDef.json#/definitions/WiderRegionId"
                                },
                                "description": "The wider regions the nation declares, most general first."
                            },
                            "wider_region": {
                                "$ref": "./CommonDef.json#/definitions/WiderRegionId",
                                "deprecated": true,
                                "description": "Present only when the nation declares exactly one wider region; read `wider_regions`."
                            },
                            "dioceses": {
                                "type": "array",
                                "items": {
                                    "$ref": "./CommonDef.json#/definitions/DiocesanCalendarId"
                                }
                            },
                            "settings": {
                                "$ref": "./CommonDef.json#/definitions/CalendarSettings"
                            }
                        },
                        "required": ["calendar_id", "missals", "wider_regions"]
                    }
                },
                "national_calendars_keys": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "$ref": "./CommonDef.json#/definitions/Nation"
                    }
                },
                "diocesan_calendars": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "calendar_id": {
                                "$ref": "./CommonDef.json#/definitions/DiocesanCalendarId"
                            },
                            "nation": {
                                "$ref": "./CommonDef.json#/definitions/Nation"
                            },
                            "diocese": {
                                "$ref": "./CommonDef.json#/definitions/DioceseName"
                            },
                            "locales": {
                                "type": "array",
                                "items": {
                                    "$ref": "./CommonDef.json#/definitions/Locale"
                                }
                            },
                            "timezone": {
                                "$ref": "./CommonDef.json#/definitions/Timezone"
                            },
                            "group": {
                                "type": "string"
                            },
                            "settings": {
                                "$ref": "./CommonDef.json#/definitions/CalendarSettings"
                            },
                            "rite": {
                                "type": "string",
                                "enum": ["roman", "ambrosian"]
                            }
                        },
                        "required": [
                            "calendar_id",
                            "locales",
                            "nation",
                            "diocese",
                            "rite"
                        ]
                    }
                },
                "diocesan_calendars_keys": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "$ref": "./CommonDef.json#/definitions/DiocesanCalendarId"
                    }
                },
                "diocesan_groups": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "group_name": {
                                "type": "string"
                            },
                            "dioceses": {
                                "type": "array",
                                "items": {
                                    "$ref": "./CommonDef.json#/definitions/DiocesanCalendarId"
                                }
                            }
                        },
                        "required": ["group_name", "dioceses"]
                    }
                },
                "wider_regions": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/WiderRegionDef"
                    }
                },
                "wider_regions_keys": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "$ref": "./CommonDef.json#/definitions/WiderRegionId"
                    }
                },
                "locales": {
                    "type": "array",
                    "uniqueItems": true,
                    "minItems": 1,
                    "items": {
                        "$ref": "./CommonDef.json#/definitions/Locale"
                    }
                },
                "ambrosian_calendars": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/AmbrosianCalendarDef"
                    }
                },
                "ambrosian_calendars_keys": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "enum": ["ambrosian"]
                    }
                }
            },
            "required": [
                "national_calendars",
                "national_calendars_keys",
                "diocesan_calendars",
                "diocesan_calendars_keys",
                "diocesan_groups",
                "wider_regions",
                "wider_regions_keys",
                "locales",
                "ambrosian_calendars",
                "ambrosian_calendars_keys"
            ],
            "additionalProperties": false
        },
        "AmbrosianCalendarDef": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "calendar_id": {
                    "type": "string",
                    "description": "the path segment identifying the comune calendar, used as /calendar/{calendar_id}",
                    "enum": ["ambrosian"]
                },
                "rite": {
                    "type": "string",
                    "description": "the liturgical rite this comune calendar is computed under",
                    "enum": ["ambrosian"]
                },
                "locales": {
                    "type": "array",
                    "items": {
                        "$ref": "./CommonDef.json#/definitions/Locale"
                    }
                },
                "settings": {
                    "description": "the calendar settings this rite fixes for every calendar computed under it; announced so that clients can discover them without first issuing a calculation request. Same shape as national_calendars[].settings and diocesan_calendars[].settings. The holydays_of_obligation event_keys are the rite's own and do not overlap the Roman ones.",
                    "$ref": "./CommonDef.json#/definitions/CalendarSettings"
                }
            },
            "required": ["calendar_id", "rite", "locales", "settings"]
        },
        "WiderRegionDef": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "name": {
                    "$ref": "./CommonDef.json#/definitions/WiderRegionName"
                },
                "locales": {
                    "type": "array",
                    "items": {
                        "$ref": "./CommonDef.json#/definitions/Locale"
                    }
                },
                "api_path": {
                    "type": "string",
                    "description": "Template URL for the wider region endpoint; {locale} must be substituted and path segments URL-encoded by clients.",
                    "pattern": "^https?:\\\/\\\/(?:litcal\\.johnromanodorazio\\.com\\\/api\\\/(?:dev|v[3-9]|v[1-9]\\d+)|(?:localhost|127\\.0\\.0\\.1)(?:\\:\\d{4}))\\\/data\\\/widerregion\\\/[a-z]+(?:-[a-z]+)*\\?locale=\\{locale\\}$"
                },
                "national_calendars": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "$ref": "./CommonDef.json#/definitions/Nation"
                    },
                    "description": "Codes of the nations that have a calendar and declare this wider region. `roster` lists the broader set of all nations eligible to join it."
                },
                "roster": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "$ref": "./CommonDef.json#/definitions/Nation"
                    },
                    "description": "Codes of every nation eligible to join this wider region, including nations with no calendar yet (the region's own `national_calendars` map). `national_calendars` lists the subset that have a calendar and declare the region."
                }
            },
            "required": ["name", "locales", "api_path", "national_calendars", "roster"]
        }
    }
}
