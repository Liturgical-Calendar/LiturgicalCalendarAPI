#: src/Handlers/CalendarHandler.php:3883
#, php-format
msgid ""
"The %1$s '%2$s' would have been transferred from %3$s to %4$s as per the "
"%5$s, to make room for '%6$s', however it is suppressed by the %7$s '%8$s' "
"in the year %9$d."
msgstr ""
"Le %1$s '%2$s' aurait été transféré du %3$s au %4$s selon le %5$s, pour "
"faire de la place pour '%6$s', cependant il est supprimé par le %7$s '%8$s' "
"en l'année %9$d."

